{
  "resources": {
    "includes": [
      {
        "pattern": ".*\\.xml"
      },
      {
        "pattern": ".*\\.yml"
      },
      {
        "pattern": ".*\\.yaml"
      },
      {
        "pattern": ".*\\.properties"
      },
      {
        "pattern": "application.*"
      },
      {
        "pattern": "mapper/.*"
      },
      {
        "pattern": "h2mapper/.*"
      },
      {
        "pattern": "static/.*"
      },
      {
        "pattern": "templates/.*"
      },
      {
        "pattern": "\\Qorg/hibernate/validator/ValidationMessages.properties\\E"
      },
      {
        "pattern": "\\Qorg/hibernate/validator/ValidationMessages_en.properties\\E"
      }
    ]
  },
  "bundles": [
    {
      "name": "org.hibernate.validator.ValidationMessages"
    },
    {
      "name": "ValidationMessages"
    }
  ]
}