<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.spring.shopagent.h2mapper.H2Mapper">

    <select id="selectNow" resultType="java.lang.String">
        SELECT NOW()
    </select>

    <update id="updateDatabaseName" parameterType="map">
        UPDATE TABLE_INFO SET database_name = #{databaseName}
    </update>

    <select id="selectDatabaseInfo" resultType="org.spring.shopagent.info.dto.DatabaseInfoResponseDTO">
        SELECT
            DATABASE_NAME AS databaseName,
            TABLE_NAME AS tableName,
            COLUMN_NAME AS columnName
        FROM TABLE_INFO
    </select>
</mapper>
